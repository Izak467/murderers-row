rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Daily score collections — one pair (normal / hard) per era.
    // Keep this list in sync with ERA_CONFIG's fbColl / fbCollHard in index.html;
    // a collection missing here fails the leaderboard write with permission-denied.
    match /{coll}/{docId} {
      allow read: if request.auth != null
        && coll in ['scores','scores_steroid','scores_nostalgia',
                    'scores_postwar','scores_golden','scores_deadball',
                    'hardScores','hardScores_steroid','hardScores_nostalgia',
                    'hardScores_postwar','hardScores_golden','hardScores_deadball'];

      allow create: if request.auth != null
        && coll in ['scores','scores_steroid','scores_nostalgia',
                    'scores_postwar','scores_golden','scores_deadball',
                    'hardScores','hardScores_steroid','hardScores_nostalgia',
                    'hardScores_postwar','hardScores_golden','hardScores_deadball']
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.wins is int
        && request.resource.data.wins >= 0
        && request.resource.data.wins <= 162
        && request.resource.data.date is string
        && request.resource.data.ts is int;

      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Claimable usernames. The handle IS the document ID, so uniqueness comes
    // free: Firestore only treats a write as `create` when the doc doesn't
    // exist, and `update` is denied — first claimer wins, everyone after gets
    // permission-denied. Delete is owner-only so a rename can release the old
    // handle instead of orphaning it.
    match /usernames/{name} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid','ts'])
        && name.size() >= 3
        && name.size() <= 16
        && name.matches('^[a-z0-9_]+$');
      allow update: if false;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /challenges/{id} {
      allow get: if true;
      allow list: if false;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['era','wins','slots','uid','ts'])
        && request.resource.data.wins is int
        && request.resource.data.wins >= 0
        && request.resource.data.wins <= 162;
      allow update: if request.auth != null
        && resource.data.p2wins == null
        && request.auth.uid != resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['p2wins','p2era','p2slots','p2uid','p2ts']);
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
